// Copy to an untracked file and replace every placeholder. Production CI passes
// secure values directly from a protected GitHub Environment instead.
using './main.bicep'

param environmentName = 'prod'
param location = 'uksouth'
param tenantId = '<entra-tenant-id>'
param gatewayApplicationClientId = '<gateway-client-id>'
param gatewayResourceUri = 'api://<gateway-client-id>'
param allowedGatewayScopesCsv = 'api://<gateway-client-id>/access_as_user=<permission-uuid>'

// The bootstrap script creates the registry and runtime identity because both
// are prerequisites for image publication and Microsoft Graph consent.
param acrName = '<globally-unique-acr-name>'
param managedIdentityClientId = '<runtime-managed-identity-client-id>'
param managedIdentityResourceId = '<runtime-managed-identity-resource-id>'

// Always deploy an immutable image digest in production.
param containerImage = '<registry>.azurecr.io/janus-keycloak@sha256:<digest>'

// Do not commit real values. These examples intentionally cannot authenticate.
param keycloakAdminPassword = '<supply-securely>'
param postgresAdministratorPassword = '<supply-securely>'

// Public ingress is opt-in. For internet exposure, keep initial-access-token admission enabled
// and add Front Door WAF or another edge rate limiter in front of Container Apps.
param externalIngressEnabled = false
param allowedIngressCidrs = []

param cleanupRetentionDays = 30
param cleanupDryRun = true
param cleanupMaxDeletesPerRun = 20

// To use pre-existing networking, set all three IDs together.
// param useExistingNetwork = true
// param existingContainerAppsSubnetId = '/subscriptions/.../subnets/...'
// param existingPostgresSubnetId = '/subscriptions/.../subnets/...'
// param existingPostgresPrivateDnsZoneId = '/subscriptions/.../privateDnsZones/private.postgres.database.azure.com'
